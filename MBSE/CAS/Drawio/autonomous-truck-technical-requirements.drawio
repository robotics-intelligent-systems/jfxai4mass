 and configuration for every run." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=14;fontColor=#203D52;fontStyle=0;" vertex="1" parent="method"><mxGeometry x="14" y="41" width="787" height="73" as="geometry" /></mxCell><mxCell id="blocker" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="905" y="980" width="815" height="125" as="geometry" /></mxCell><mxCell id="blocker-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#B44036;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="blocker"><mxGeometry x="0" y="0" width="815" height="5" as="geometry" /></mxCell><mxCell id="blocker-title" value="Release blocker" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#B44036;fontStyle=1;" vertex="1" parent="blocker"><mxGeometry x="14" y="13" width="787" height="25" as="geometry" /></mxCell><mxCell id="blocker-body" value="Unresolved ODD, missing fallback evidence, unqualified energy/sensor interfaces, uncorrelated simulation,&#10;uncontrolled AI updates or incomplete serial traceability prevents release." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=14;fontColor=#203D52;fontStyle=0;" vertex="1" parent="blocker"><mxGeometry x="14" y="41" width="787" height="73" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>