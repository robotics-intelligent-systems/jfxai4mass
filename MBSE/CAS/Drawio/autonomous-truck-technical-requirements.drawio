<mxfile host="app.diagrams.net" modified="2026-09-12T00:00:00.000Z" agent="Codex" version="24.7.17" compressed="false"><diagram id="icecream-1" name="01 Requirements"><mxGraphModel dx="1760" dy="1160" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1160" math="0" shadow="0" background="#F4F7FA"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="header" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#102C46;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1760" height="100" as="geometry" /></mxCell><mxCell id="title" value="OpenTwin | Autonomous Truck Prototype" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=30;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1350" height="42" as="geometry" /></mxCell><mxCell id="subtitle" value="High-level technical specifications | Mission, platform, autonomy, safety, digital twin and lifecycle" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=15;fontColor=#C8DCEB;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1370" height="24" as="geometry" /></mxCell><mxCell id="page-no" value="01 / REQUIREMENTS" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=right;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=17;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1450" y="27" width="270" height="50" as="geometry" /></mxCell><mxCell id="footer" value="JFXAI4FTM • Proposed requirements baseline v0.1 • 12 Sep 2026 • Concept artwork is not a dimensioned engineering design" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=12;fontColor=#526779;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1680" height="22" as="geometry" /></mxCell><mxCell id="evidence" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="515" height="240" as="geometry" /></mxCell><mxCell id="evidence-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#176F9B;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="evidence"><mxGeometry x="0" y="0" width="515" height="5" as="geometry" /></mxCell><mxCell id="evidence-title" value="Concept evidence [S1–S2]" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#176F9B;fontStyle=1;" vertex="1" parent="evidence"><mxGeometry x="14" y="13" width="487" height="25" as="geometry" /></mxCell><mxCell id="evidence-body" value="Autonomous truck prototype within the open mobility&#10;research family.&#10;&#10;The repository context emphasizes modular hardware, open&#10;vehicle interfaces, MBSE, Modelica, simulation, digital twins&#10;and AI as replaceable engineering layers." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#203D52;fontStyle=0;" vertex="1" parent="evidence" link="https://github.com/robotics-intelligent-systems/jfxai4mass/blob/main/MBSE/CAD/autonomous-truck-prototype.jpg"><mxGeometry x="14" y="41" width="487" height="188" as="geometry" /></mxCell><mxCell id="system" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="585" y="125" width="635" height="240" as="geometry" /></mxCell><mxCell id="system-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#102C46;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="system"><mxGeometry x="0" y="0" width="635" height="5" as="geometry" /></mxCell><mxCell id="system-title" value="REQ-SYS | Modular autonomous mobility platform" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#102C46;fontStyle=1;" vertex="1" parent="system"><mxGeometry x="14" y="13" width="607" height="25" as="geometry" /></mxCell><mxCell id="system-body" value="Provide a configurable ground vehicle for research, logistics or&#10;utility missions inside a declared operational design domain.&#10;Preserve road/terrain behavior, payload integrity, local safety,&#10;human oversight, cybersecurity and model-to-test traceability." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#203D52;fontStyle=0;" vertex="1" parent="system"><mxGeometry x="14" y="41" width="607" height="188" as="geometry" /></mxCell><mxCell id="reference" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1270" y="125" width="450" height="240" as="geometry" /></mxCell><mxCell id="reference-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#665093;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="reference"><mxGeometry x="0" y="0" width="450" height="5" as="geometry" /></mxCell><mxCell id="reference-title" value="Concept reference [S1]" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#665093;fontStyle=1;" vertex="1" parent="reference"><mxGeometry x="14" y="13" width="422" height="25" as="geometry" /></mxCell><mxCell id="reference-body" value="Source image: autonomous-truck-prototype.jpg&#10;&#10;The artwork is a system-context reference, not a&#10;dimensioned CAD model, performance specification&#10;or safety certification. All numerical targets remain&#10;TBD." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#203D52;fontStyle=0;" vertex="1" parent="reference" link="https://github.com/robotics-intelligent-systems/jfxai4mass/blob/main/MBSE/CAD/autonomous-truck-prototype.jpg"><mxGeometry x="14" y="41" width="422" height="188" as="geometry" /></mxCell><mxCell id="proposed" value="R01–R24 are proposed engineering requirements. Close ODD, payload, dimensions, mass, energy, sensor suite, fallback behavior, cybersecurity and regulatory assumptions before design release." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=15;fontColor=#526779;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="1680" height="24" as="geometry" /></mxCell><mxCell id="g1" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="260" height="635" as="geometry" /></mxCell><mxCell id="g1-head" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#176F9B;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="g1"><mxGeometry x="0" y="0" width="260" height="