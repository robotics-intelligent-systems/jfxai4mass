e" value="MBSE, simulation and validation" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#102C46;fontStyle=1;" vertex="1" parent="simulation"><mxGeometry x="14" y="13" width="472" height="25" as="geometry" /></mxCell><mxCell id="simulation-body" value="Modelica vehicle and energy models&#10;Scenario and traffic simulation&#10;SIL / HIL / prototype correlation&#10;Digital-twin calibration&#10;AI data and regression tests&#10;R20–R24" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=17;fontColor=#203D52;fontStyle=0;" vertex="1" parent="simulation"><mxGeometry x="14" y="41" width="472" height="168" as="geometry" /></mxCell><mxCell id="modes" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="530" height="178" as="geometry" /></mxCell><mxCell id="modes-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#176F9B;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="modes"><mxGeometry x="0" y="0" width="530" height="5" as="geometry" /></mxCell><mxCell id="modes-title" value="Operational modes" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#176F9B;fontStyle=1;" vertex="1" parent="modes"><mxGeometry x="14" y="13" width="502" height="25" as="geometry" /></mxCell><mxCell id="modes-body" value="Standby → prepare → manual/remote → autonomous →&#10;degraded → minimal-risk stop → maintenance. Each transition&#10;requires authorization, preconditions, indication and event&#10;logging." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#203D52;fontStyle=0;" vertex="1" parent="modes"><mxGeometry x="14" y="41" width="502" height="126" as="geometry" /></mxCell><mxCell id="boundary" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="615" y="790" width="530" height="178" as="geometry" /></mxCell><mxCell id="boundary-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#B44036;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="boundary"><mxGeometry x="0" y="0" width="530" height="5" as="geometry" /></mxCell><mxCell id="boundary-title" value="Safety boundary" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#B44036;fontStyle=1;" vertex="1" parent="boundary"><mxGeometry x="14" y="13" width="502" height="25" as="geometry" /></mxCell><mxCell id="boundary-body" value="Actuation limits, emergency stop, power protection,&#10;watchdogs and fallback are local and qualified. Cloud,&#10;dashboards, digital twins and AI provide supervision or advice&#10;only." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#203D52;fontStyle=0;" vertex="1" parent="boundary"><mxGeometry x="14" y="41" width="502" height="126" as="geometry" /></mxCell><mxCell id="open" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1190" y="790" width="530" height="178" as="geometry" /></mxCell><mxCell id="open-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#665093;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="open"><mxGeometry x="0" y="0" width="530" height="5" as="geometry" /></mxCell><mxCell id="open-title" value="Open architecture rule" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#665093;fontStyle=1;" vertex="1" parent="open"><mxGeometry x="14" y="13" width="502" height="25" as="geometry" /></mxCell><mxCell id="open-body" value="Candidate technologies are replaceable integrations. Define&#10;ICDs for vehicle, sensors, payload, telemetry and&#10;co-simulation; preserve portability across compute, simulator&#10;and model providers." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#203D52;fontStyle=0;" vertex="1" parent="open"><mxGeometry x="14" y="41" width="502" height="126" as="geometry" /></mxCell><mxCell id="failure" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="1680" height="115" as="geometry" /></mxCell><mxCell id="failure-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#102C46;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="failure"><mxGeometry x="0" y="0" width="1680" height="5" as="geometry" /></mxCell><mxCell id="failure-title" value="Failure behavior" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#102C46;fontStyle=1;" vertex="1" parent="failure"><mxGeometry x="14" y="13" width="1652" height="25" as="geometry" /></mxCell><mxCell id="failure-body" value="Loss of sensor confidence, localization, compute, communication, energy or actuator health shall be explicit. The vehicle shall execute the approved fallback and shall not infer “safe” from&#10;missing data." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=17;fontColor=#203D52;fontStyle=0;" vertex="1" parent="failure"><mxGeometry x="14" y="41" width="1652" height="63" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="icecream-3" name="03 Materials"><mxGraphModel dx="1760" dy="1160" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1160" math="0" shadow="0" background="#F4F7FA"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="header" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#102C46;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1760" height="100" as="geometry" /></mxCell><mxCell id="title" value="OpenTwin | Autonomous Truck Prototype" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=30;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1350" height="42" as="geometry" /></mxCell><mxCell id="subtitle" value="Structural, energy and sensor integration | Open material choices with controlled interfaces" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=15;fontColor=#C8DCEB;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1370" height="24" as="geometry" /></mxCell><mxCell id="page-no" value="03 / MATERIALS" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=right;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=17;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1450" y="27" width="270" height="50" as="geometry" /></mxCell><mxCell id="footer" value="JFXAI4FTM • Proposed requirements baseline v0.1 • 12 Sep 2026 • Concept artwork is not a dimensioned engineering design" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=12;fontColor=#526779;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1680" height="22" as="geometry" /></mxCell><mxCell id="structure-zone" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="530" height="140" as="geometry" /></mxCell><mxCell id="structure-zone-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#176F9B;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="structure-zone"><mxGeometry x="0" y="0" width="530" height="5" as="geometry" /></mxCell><mxCell id="structure-zone-title" value="STRUCTURE | load path and repair" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#176F9B;fontStyle=1;" vertex="1" parent="structure-zone"><mxGeometry x="14" y="13" width="502" height="25" as="geometry" /></mxCell><mxCell id="structure-zone-body" value="Use a maintainable primary structure with documented load&#10;paths, corrosion protection, modular mounts and inspection&#10;access. Validate every payload configuration." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#203D52;fontStyle=0;" vertex="1" parent="structure-zone"><mxGeometry x="14" y="41" width="502" height="88" as="geometry" /></mxCell><mxCell id="energy-zone" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFF9F7;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="615" y="130" width="530" height="140" as="geometry" /></mxCell><mxCell id="energy-zone-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#B44036;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="energy-zone"><mxGeometry x="0" y="0" width="530" height="5" as="geometry" /></mxCell><mxCell id="energy-zone-title" value="ENERGY | battery and high current" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#B44036;fontStyle=1;" vertex="1" parent="energy-zone"><mxGeometry x="14" y="13" width="502" height="25" as="geometry" /></mxCell><mxCell id="energy-zone-body" value="Separate energy storage, power electronics and charging&#10;from impact, water and public/service areas. Define&#10;containment, isolation, thermal propagation and emergency&#10;disconnect." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#203D52;fontStyle=0;" vertex="1" parent="energy-zone"><mxGeometry x="14" y="41" width="502" height="88" as="geometry" /></mxCell><mxCell id="sensor-zone" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1190" y="130" width="530" height="140" as="geometry" /></mxCell><mxCell id="sensor-zone-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#946218;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="sensor-zone"><mxGeometry x="0" y="0" width="530" height="5" as="geometry" /></mxCell><mxCell id="sensor-zone-title" value="SENSORS | field of view and calibration" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#946218;fontStyle=1;" vertex="1" parent="sensor-zone"><mxGeometry x="14" y="13" width="502" height="25" as="geometry" /></mxCell><mxCell id="sensor-zone-body" value="Protect optics, radomes, wiring and compute from&#10;environment while preserving calibration, cleaning,&#10;diagnostics and redundant coverage." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#203D52;fontStyle=0;" vertex="1" parent="sensor-zone"><mxGeometry x="14" y="41" width="502" height="88" as="geometry" /></mxCell><mxCell id="mh0" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#102C46;strokeColor=#FFFFFF;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="305" width="140" height="44" as="geometry" /></mxCell><mxCell id="mht0" value="ID" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=14;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="316" width="120" height="25" as="geometry" /></mxCell><mxCell id="mh1" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#102C46;strokeColor=#FFFFFF;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="180" y="305" width="240" height="44" as="geometry" /></mxCell><mxCell id="mht1" value="Material" style="html=0;whiteSpace=wrap;overflow=hid