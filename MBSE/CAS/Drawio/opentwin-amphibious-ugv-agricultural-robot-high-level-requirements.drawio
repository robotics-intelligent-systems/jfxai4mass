        <mxCell id="title" value="OpenTwin | Amphibious UGV and agricultural robot | 03 | Acceptance parameters" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=24;fontColor=#ffffff;fillColor=#16324f;strokeColor=#bac9d8;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="TBD-1" value="TBD-UGV-01 | Water depth, current, wave and shoreline limits&lt;br&gt;&lt;br&gt;Owner: systems engineering with allocated domain lead. Closure: analysis and&lt;br&gt;stakeholder review establish measurable limits and verification scenarios&lt;br&gt;before&lt;br&gt;G1. Status: open; no value inferred from artwork." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#152b43;fillColor=#ffffff;strokeColor=#bac9d8;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="740" height="360" as="geometry" />
        </mxCell>
        <mxCell id="TBD-2" value="TBD-UGV-02 | Loaded displacement, freeboard and stability margins&lt;br&gt;&lt;br&gt;Owner: systems engineering with allocated domain lead. Closure: analysis and&lt;br&gt;stakeholder review establish measurable limits and verification scenarios&lt;br&gt;before&lt;br&gt;G1. Status: open; no value inferred from artwork." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#152b43;fillColor=#ffffff;strokeColor=#bac9d8;" vertex="1" parent="1">
          <mxGeometry x="820" y="140" width="740" height="360" as="geometry" />
        </mxCell>
        <mxCell id="TBD-3" value="TBD-UGV-03 | Water propulsion choice and energy reserve&lt;br&gt;&lt;br&gt;Owner: systems engineering with allocated domain lead. Closure: analysis and&lt;br&gt;stakeholder review establish measurable limits and verification scenarios&lt;br&gt;before&lt;br&gt;G1. Status: open; no value inferred from artwork." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#152b43;fillColor=#ffffff;strokeColor=#bac9d8;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="740" height="360" as="geometry" />
        </mxCell>
        <mxCell id="TBD-4" value="TBD-UGV-04 | Robot dimensions, mass, retention and ramp load/slope&lt;br&gt;&lt;br&gt;Owner: systems engineering with allocated domain lead. Closure: analysis and&lt;br&gt;stakeholder review establish measurable limits and verification scenarios&lt;br&gt;before&lt;br&gt;G1. Status: open; no value inferred from artwork." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#152b43;fillColor=#ffffff;strokeColor=#bac9d8;" vertex="1" parent="1">
          <mxGeometry x="820" y="520" width="740" height="360" as="geometry" />
        </mxCell>
        <mxCell id="TBD-5" value="TBD-UGV-05 | Selected agricultural task and crop constraints&lt;br&gt;&lt;br&gt;Owner: systems engineering with allocated domain lead. Closure: analysis and&lt;br&gt;stakeholder review establish measurable limits and verification scenarios&lt;br&gt;before&lt;br&gt;G1. Status: open; no value inferred from artwork." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#152b43;fillColor=#ffffff;strokeColor=#bac9d8;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="740" height="360" as="geometry" />
        </mxCell>
        <mxCell id="TBD-6" value="TBD-UGV-06 | Communication-loss timing and minimum-risk behavior&lt;br&gt;&lt;br&gt;Owner: systems engineering with allocated domain lead. Closure: analysis and&lt;br&gt;stakeholder review establish measurable limits and verification scenarios&lt;br&gt;before&lt;br&gt;G1. Status: open; no value inferred from artwork." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#152b43;fillColor=#ffffff;strokeColor=#bac9d8;" vertex="1" parent="1">
          <mxGeometry x="820" y="900" width="740" height="360" as="geometry" />
        </mxCell>
        <mxCell id="TBD-7" value="TBD-UGV-07 | Autonomy level, exclusion zones and intervention limits&lt;br&gt;&lt;br&gt;Owner: systems engineering with allocated domain lead. Closure: analysis and&lt;br&gt;stakeholder review establish measurable limits and verification scenarios&lt;br&gt;before&lt;br&gt;G1. Status: open; no value inferred from artwork." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#152b43;fillColor=#ffffff;strokeColor=#bac9d8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1280" width="740" height="360" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>