        <mxCell id="p3_r3" value="&lt;b&gt;R-05&lt;/b&gt; Drive-by-wire, state estimation, operator override and autonomy-ready control." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#60a5fa;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="p3_1"><mxGeometry x="30" y="341" width="480" height="58" as="geometry"/></mxCell>
