        <mxCell id="p3_v6" value="&lt;b&gt;V-06&lt;/b&gt; FMEA/FTA, fault injection, safe-mode demonstration, loss-of-link test and recovery evidence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#7c2d12;fontSize=11;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="p3_1"><mxGeometry x="1070" y="545" width="500" height="58" as="geometry"/></mxCell>
