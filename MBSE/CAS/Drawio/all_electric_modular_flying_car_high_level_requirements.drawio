        <mxCell id="p3_footer" value="&lt;b&gt;Traceability rule:&lt;/b&gt; no requirement is complete until its owner, allocation, rationale, verification method, acceptance threshold, configuration reference and evidence location are defined." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;fontColor=#334155;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="p3_1"><mxGeometry x="30" y="915" width="1540" height="48" as="geometry"/></mxCell>
