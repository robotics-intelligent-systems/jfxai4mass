        <mxCell id="p3_v7" value="&lt;b&gt;V-07&lt;/b&gt; State-machine analysis, scenario replay, mode-transition test and integrated demonstration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#7c2d12;fontSize=11;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="p3_1"><mxGeometry x="1070" y="613" width="500" height="58" as="geometry"/></mxCell>
        <mxCell id="p3_r8" value="&lt;b&gt;R-10&lt;/b&gt; Define environmental envelope, maintainability, energy efficiency and lifecycle responsibilities." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#60a5fa;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="p3_1"><mxGeometry x="30" y="681" width="480" height="58" as="geometry"/></mxCell>
        <mxCell id="p3_a8" value="&lt;b&gt;S-01 / S-02 / E-03&lt;/b&gt; Structure, energy service, maintenance configuration and lifecycle data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#4ade80;fontColor=#14532d;fontSize=11;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="p3_1"><mxGeometry x="550" y="681" width="480" height="58" as="geometry"/></mxCell>
        <mxCell id="p3_v8" value="&lt;b&gt;V-08&lt;/b&gt; Environmental analysis, maintainability demonstration, energy/lifecycle assessment and service audit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#7c2d12;fontSize=11;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="p3_1"><mxGeometry x="1070" y="681" width="500" height="58" as="geometry"/></mxCell>
        <mxCell id="p3_r9" value="&lt;b&gt;TBD-01&lt;/b&gt; Mass, payload, speed, range/endurance, voltage, capacity, latency and environmental thresholds." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontColor=#7c2d12;fontSize=11;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="p3_1"><mxGeometry x="30" y="749" width="480" height="58" as="geometry"/></mxCell>
