<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-09-12T00:00:00.000Z" agent="Codex" version="31.4.2" type="device" compressed="false" pages="5">
  <diagram id="mass-req-baseline" name="01 - Requirements Baseline">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p1_0"/>
        <mxCell id="p1_1" parent="p1_0"/>
        <mxCell id="p1_title" value="&lt;b&gt;OpenTwin MASS — High-Level Technical Requirements&lt;/b&gt;&lt;br&gt;All-electric modular ground platform with optional multi-mission UAV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;fontSize=21;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="p1_1">
          <mxGeometry x="30" y="20" width="1540" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="p1_subtitle" value="&lt;b&gt;System boundary:&lt;/b&gt; open, modular, interoperable mobility and aerial systems — conceptual baseline for MBSE allocation and verification planning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="p1_1">
          <mxGeometry x="30" y="94" width="1540" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="p1_source" value="&lt;b&gt;Reference concept&lt;/b&gt;&lt;br&gt;all-electric-modular-flying-car-concept.jpg&lt;br&gt;&lt;br&gt;Repository: robotics-intelligent-systems/jfxai4mass&lt;br&gt;Source path: MBSE/CAD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p1_1" link="https://github.com/robotics-intelligent-systems/jfxai4mass/blob/main/MBSE/CAD/all-electric-modular-flying-car-concept.jpg">
          <mxGeometry x="30" y="155" width="390" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="p1_mission" value="&lt;b&gt;R-01 — Mission need&lt;/b&gt;&lt;br&gt;Support multiple ground and aerial mobility missions through one reusable platform and interchangeable modules.&lt;br&gt;&lt;br&gt;&lt;b&gt;Actors:&lt;/b&gt; operator, maintainer, mission planner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfeff;strokeColor=#0891b2;fontColor=#164e63;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p1_1">
          <mxGeometry x="445" y="155" width="350" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="p1_soi" value="&lt;b&gt;SYSTEM OF INTEREST&lt;/b&gt;&lt;br&gt;OpenTwin MASS&lt;br&gt;&lt;br&gt;All-electric modular ground vehicle, optional detachable UAV, payload bay, digital twin and open control/data interfaces." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#172554;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p1_1">
          <mxGeometry x="820" y="155" width="350" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="p1_constraints" value="&lt;b&gt;R-02 — Architecture constraints&lt;/b&gt;&lt;br&gt;Open source, modular, interoperable and technology-neutral; avoid mandatory vendor lock-in.&lt;br&gt;&lt;br&gt;Interfaces shall be replaceable and versioned." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p1_1">
          <mxGeometry x="1195" y="155" width="375" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="p1_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p1_1" source="p1_mission" target="p1_soi">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p1_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p1_1" source="p1_soi" target="p1_constraints">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p1_energy" value="&lt;b&gt;R-03 — All-electric energy&lt;/b&gt;&lt;br&gt;Provide modular energy storage, power distribution, battery management, thermal management and safe service isolation.&lt;br&gt;&lt;br&gt;Evidence: energy model, BMS tests, abuse and isolation tests." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p1_1">
          <mxGeometry x="30" y="330" width="360" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="p1_modularity" value="&lt;b&gt;R-04 — Modular payload bay&lt;/b&gt;&lt;br&gt;Accommodate interchangeable cargo, research, rescue, utility and UAV payloads through defined mechanical, electrical and data interfaces.&lt;br&gt;&lt;br&gt;Evidence: interface control document and fit/function test." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p1_1">
          <mxGeometry x="410" y="330" width="360" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="p1_autonomy" value="&lt;b&gt;R-05 — Drive-by-wire and autonomy&lt;/b&gt;&lt;br&gt;Support deterministic vehicle control, state estimation, operator override and autonomous-ready control interfaces.&lt;br&gt;&lt;br&gt;Evidence: control model, SIL/HIL, ground test and fault injection." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p1_1">
          <mxGeometry x="790" y="330" width="360" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="p1_open" value="&lt;b&gt;R-06 — Open integration&lt;/b&gt;&lt;br&gt;Expose replaceable interfaces for ROS 2, vehicle API, telemetry, V2X, edge compute and optional cloud services.&lt;br&gt;&lt;br&gt;Evidence: protocol conformance, API tests and interoperability demonstration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p1_1">
          <mxGeometry x="1190" y="330" width="380" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="p1_sim" value="&lt;b&gt;R-07 — Digital twin and physics&lt;/b&gt;&lt;br&gt;Maintain executable Modelica and multiphysics models linked to configuration, telemetry, scenarios and measured data.&lt;br&gt;&lt;br&gt;Evidence: model review, co-simulation and correlation report." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;fontColor=#166534;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p1_1">
          <mxGeometry x="30" y="545" width="360" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="p1_safety" value="&lt;b&gt;R-08 — Safety and degraded modes&lt;/b&gt;&lt;br&gt;Detect faults, isolate hazards, preserve controllability and transition to defined safe ground or flight modes.&lt;br&gt;&lt;br&gt;Evidence: hazard analysis, FMEA/FTA, fault injection and safe-mode demonstration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p1_1">
          <mxGeometry x="410" y="545" width="360" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="p1_ops" value="&lt;b&gt;R-09 — Multi-domain operations&lt;/b&gt;&lt;br&gt;Coordinate ground vehicle, detachable UAV, payload and mission-control states with explicit mode isolation and authority management.&lt;br&gt;&lt;br&gt;Evidence: state machine, scenario replay and integrated demonstration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p1_1">
          <mxGeometry x="790" y="545" width="360" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="p1_env" value="&lt;b&gt;R-10 — Environment and sustainability&lt;/b&gt;&lt;br&gt;Define environmental envelope, maintainability, energy efficiency, battery lifecycle, serviceability and responsible material choices.&lt;br&gt;&lt;br&gt;Evidence: environmental analysis, maintainability demonstration and lifecycle assessment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p1_1">
          <mxGeometry x="1190" y="545" width="380" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="p1_tbd" value="&lt;b&gt;TBD — Performance allocation before design freeze&lt;/b&gt;&lt;br&gt;Mass, dimensions, payload, ground speed, flight speed and altitude, range/endurance, energy capacity and voltage, recharge/swap time, wind/temperature/precipitation envelope, noise, communication latency, availability and safety targets.&lt;br&gt;&lt;br&gt;Each value requires an owner, rationale, model reference, verification method and acceptance threshold." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontColor=#7c2d12;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p1_1">
          <mxGeometry x="30" y="760" width="1540" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="p1_note" value="&lt;b&gt;Baseline status:&lt;/b&gt; conceptual requirements for MBSE and simulation planning. The diagram is not a certified aircraft, automotive design or manufacturing drawing; operational values require independent engineering, safety and regulatory review." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;fontColor=#334155;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="p1_1">
          <mxGeometry x="30" y="920" width="1540" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="p1_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#94a3b8;" edge="1" parent="p1_1" source="p1_soi" target="p1_energy">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p1_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#94a3b8;" edge="1" parent="p1_1" source="p1_soi" target="p1_modularity">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p1_e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#94a3b8;" edge="1" parent="p1_1" source="p1_soi" target="p1_autonomy">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p1_e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#94a3b8;" edge="1" parent="p1_1" source="p1_soi" target="p1_sim">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p1_e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#94a3b8;" edge="1" parent="p1_1" source="p1_soi" target="p1_safety">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p1_e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#94a3b8;" edge="1" parent="p1_1" source="p1_soi" target="p1_ops">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p1_e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#94a3b8;" edge="1" parent="p1_1" source="p1_soi" target="p1_env">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="mass-architecture" name="02 - Functional and Physical Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p2_0"/>
        <mxCell id="p2_1" parent="p2_0"/>
        <mxCell id="p2_title" value="&lt;b&gt;Functional and Physical Architecture&lt;/b&gt;&lt;br&gt;Allocation of the concept into replaceable subsystems and interfaces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;fontSize=21;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="p2_1">
          <mxGeometry x="30" y="20" width="1540" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="p2_context" value="&lt;b&gt;Concept cues:&lt;/b&gt; modular design · open interfaces · Modelica simulation · open-source AI · edge and cloud · sustainable mobility · ground vehicle + detachable multi-mission UAV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="p2_1">
          <mxGeometry x="30" y="94" width="1540" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="p2_ground_boundary" value="&lt;b&gt;GROUND MODULAR PLATFORM&lt;/b&gt;&lt;br&gt;Vehicle structure, energy, payload, sensing, control and data services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;dashed=1;fontColor=#166534;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p2_1">
          <mxGeometry x="30" y="175" width="930" height="565" as="geometry"/>
        </mxCell>
        <mxCell id="p2_uav_boundary" value="&lt;b&gt;OPTIONAL AERIAL MODULE&lt;/b&gt;&lt;br&gt;Detachable UAV, mission payload and autonomous-flight services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;dashed=1;fontColor=#1e3a8a;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p2_1">
          <mxGeometry x="990" y="175" width="580" height="565" as="geometry"/>
        </mxCell>
        <mxCell id="p2_chassis" value="&lt;b&gt;S-01 Structure and mobility&lt;/b&gt;&lt;br&gt;Chassis, wheels, electric traction, suspension, mechanical mounting and service access.&lt;br&gt;&lt;br&gt;Allocates R-03, R-04, R-10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p2_1">
          <mxGeometry x="60" y="240" width="255" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="p2_energy" value="&lt;b&gt;S-02 Energy module&lt;/b&gt;&lt;br&gt;Swappable battery, BMS, power electronics, distribution bus, thermal control and isolation.&lt;br&gt;&lt;br&gt;Allocates R-03, R-08" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontColor=#14532d;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p2_1">
          <mxGeometry x="350" y="240" width="255" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="p2_payload" value="&lt;b&gt;S-03 Payload bay&lt;/b&gt;&lt;br&gt;Interchangeable cargo, research, rescue, utility or UAV payload with mechanical, power and data ICDs.&lt;br&gt;&lt;br&gt;Allocates R-04, R-09" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p2_1">
          <mxGeometry x="640" y="240" width="255" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="p2_control" value="&lt;b&gt;S-04 Edge AI and control&lt;/b&gt;&lt;br&gt;State estimation, vehicle control, perception, planning hooks, health monitoring and operator override.&lt;br&gt;&lt;br&gt;ROS 2 · open-source AI · edge compute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p2_1">
          <mxGeometry x="60" y="405" width="255" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="p2_sensors" value="&lt;b&gt;S-05 Sensor suite&lt;/b&gt;&lt;br&gt;LiDAR, vision, IoT, GNSS/IMU and vehicle-state signals with time synchronization and diagnostics.&lt;br&gt;&lt;br&gt;Allocates R-05, R-08" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p2_1">
          <mxGeometry x="350" y="405" width="255" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="p2_comms" value="&lt;b&gt;S-06 Communications and data&lt;/b&gt;&lt;br&gt;Vehicle network, telemetry, V2X, mission link, logging and secure interfaces to external services.&lt;br&gt;&lt;br&gt;Allocates R-06, R-09" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p2_1">
          <mxGeometry x="640" y="405" width="255" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="p2_api" value="&lt;b&gt;S-07 Vehicle and payload API&lt;/b&gt;&lt;br&gt;Versioned command, state, health, power, payload and docking contracts.&lt;br&gt;&lt;br&gt;Primary boundary for replaceability and configuration control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p2_1">
          <mxGeometry x="350" y="590" width="255" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="p2_uav" value="&lt;b&gt;S-08 Multi-mission UAV&lt;/b&gt;&lt;br&gt;Electric aerial module with airframe, motors, energy interface, landing gear and payload attachment.&lt;br&gt;&lt;br&gt;Optional configuration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p2_1">
          <mxGeometry x="1020" y="245" width="245" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="p2_uavctrl" value="&lt;b&gt;S-09 Flight control&lt;/b&gt;&lt;br&gt;Autonomous flight, stabilization, navigation, geofencing, command authority and degraded modes.&lt;br&gt;&lt;br&gt;ROS 2 · PX4 or replaceable equivalent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p2_1">
          <mxGeometry x="1305" y="245" width="235" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="p2_uavpayload" value="&lt;b&gt;S-10 Aerial payload and sensors&lt;/b&gt;&lt;br&gt;Interchangeable mission payloads with vision/LiDAR/IoT sensing, health reporting and safe release/return behavior." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p2_1">
          <mxGeometry x="1020" y="430" width="245" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p2_uavsensors" value="&lt;b&gt;S-11 Flight sensing and navigation&lt;/b&gt;&lt;br&gt;IMU, GNSS, altitude/position sensing, obstacle awareness and telemetry synchronization.&lt;br&gt;&lt;br&gt;Allocates R-05, R-08" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p2_1">
          <mxGeometry x="1305" y="430" width="235" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p2_dock" value="&lt;b&gt;S-12 Docking and transfer interface&lt;/b&gt;&lt;br&gt;Mechanical retention, power transfer, data/control hand-off, identification, interlocks and release confirmation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p2_1">
          <mxGeometry x="1110" y="610" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e1" value="power" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;fontColor=#166534;fontSize=10;" edge="1" parent="p2_1" source="p2_energy" target="p2_chassis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e2" value="power bus" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;fontColor=#166534;fontSize=10;" edge="1" parent="p2_1" source="p2_energy" target="p2_control">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e3" value="sensor data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#ca8a04;fontColor=#713f12;fontSize=10;" edge="1" parent="p2_1" source="p2_sensors" target="p2_control">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e4" value="commands / state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=10;" edge="1" parent="p2_1" source="p2_control" target="p2_api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e5" value="payload ICD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=10;" edge="1" parent="p2_1" source="p2_payload" target="p2_api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e6" value="telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=10;" edge="1" parent="p2_1" source="p2_comms" target="p2_api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e7" value="mechanical / power / data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=10;" edge="1" parent="p2_1" source="p2_payload" target="p2_dock">
