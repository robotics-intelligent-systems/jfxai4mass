        <mxCell id="p3_e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p3_1" source="p3_a5" target="p3_v5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p3_1" source="p3_r6" target="p3_a6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p3_1" source="p3_a6" target="p3_v6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p3_1" source="p3_r7" target="p3_a7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p3_1" source="p3_a7" target="p3_v7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p3_1" source="p3_r8" target="p3_a8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p3_1" source="p3_a8" target="p3_v8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p3_1" source="p3_r9" target="p3_a9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_e18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p3_1" source="p3_a9" target="p3_v9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_e19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p3_1" source="p3_r10" target="p3_a10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_e20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p3_1" source="p3_a10" target="p3_v10"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="mass-vv" name="04 - Verification and Validation">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p4_0"/>
        <mxCell id="p4_1" parent="p4_0"/>
        <mxCell id="p4_title" value="&lt;b&gt;Verification and Validation Strategy&lt;/b&gt;&lt;br&gt;Progressive evidence from requirements baseline to controlled operational demonstration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;fontSize=21;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="p4_1">
          <mxGeometry x="30" y="20" width="1540" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="p4_sub" value="Verification checks that the system was built right; validation checks that the configured system supports the intended mission. Gates are evidence-based and configuration-controlled." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="p4_1">
          <mxGeometry x="30" y="94" width="1540" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="p4_g0" value="&lt;b&gt;G0 — Baseline&lt;/b&gt;&lt;br&gt;Approve mission need, system boundary, requirement IDs, owners, assumptions and TBD list." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p4_1"><mxGeometry x="45" y="190" width="275" height="110" as="geometry"/></mxCell>
        <mxCell id="p4_g1" value="&lt;b&gt;G1 — MBSE allocation&lt;/b&gt;&lt;br&gt;Review functional, logical and physical allocation; approve interfaces and configuration items." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p4_1"><mxGeometry x="345" y="190" width="275" height="110" as="geometry"/></mxCell>
        <mxCell id="p4_g2" value="&lt;b&gt;G2 — Executable models&lt;/b&gt;&lt;br&gt;Run Modelica/multiphysics co-simulation and verify units, assumptions, parameter provenance and scenario reproducibility." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p4_1"><mxGeometry x="645" y="190" width="275" height="110" as="geometry"/></mxCell>
        <mxCell id="p4_g3" value="&lt;b&gt;G3 — SIL&lt;/b&gt;&lt;br&gt;Exercise autonomy, energy, sensing, payload and mode logic in repeatable virtual scenarios with acceptance metrics." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p4_1"><mxGeometry x="945" y="190" width="275" height="110" as="geometry"/></mxCell>
        <mxCell id="p4_g4" value="&lt;b&gt;G4 — HIL and subsystem bench&lt;/b&gt;&lt;br&gt;Verify real controllers, BMS, sensors, interfaces, fault handling and timing against simulated plant behavior." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p4_1"><mxGeometry x="1245" y="190" width="310" height="110" as="geometry"/></mxCell>
        <mxCell id="p4_g5" value="&lt;b&gt;G5 — Integrated ground test&lt;/b&gt;&lt;br&gt;Demonstrate drive-by-wire, payload exchange, energy service, communications, operator override and safe stop." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p4_1"><mxGeometry x="170" y="425" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="p4_g6" value="&lt;b&gt;G6 — Controlled aerial integration&lt;/b&gt;&lt;br&gt;Only after approved safety case: tethered or constrained flight, docking/release interlocks, loss-of-link and recovery behavior." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p4_1"><mxGeometry x="520" y="425" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="p4_g7" value="&lt;b&gt;G7 — Flight-envelope expansion&lt;/b&gt;&lt;br&gt;Incremental, instrumented tests for navigation, payload, energy, autonomy and environmental limits under an approved test plan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p4_1"><mxGeometry x="870" y="425" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="p4_g8" value="&lt;b&gt;G8 — Mission validation&lt;/b&gt;&lt;br&gt;Validate representative ground, aerial and payload missions; record operator workload, performance, anomalies and disposition." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p4_1"><mxGeometry x="1220" y="425" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="p4_audit" value="&lt;b&gt;Evidence package for every gate&lt;/b&gt;&lt;br&gt;Requirement ID and acceptance threshold · model/configuration version · scenario and test setup · telemetry and logs · pass/fail result · anomalies and corrective action · reviewer/owner approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p4_1"><mxGeometry x="45" y="635" width="470" height="175" as="geometry"/></mxCell>
        <mxCell id="p4_safety" value="&lt;b&gt;Safety gates&lt;/b&gt;&lt;br&gt;• Hazard analysis before integrated operation&lt;br&gt;• Fail-safe and degraded-mode behavior tested before autonomy claims&lt;br&gt;• Human authority and emergency stop defined&lt;br&gt;• Flight tests require an approved test, airworthiness and regulatory basis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p4_1"><mxGeometry x="565" y="635" width="470" height="175" as="geometry"/></mxCell>
        <mxCell id="p4_methods" value="&lt;b&gt;Methods&lt;/b&gt;&lt;br&gt;Inspection · analysis · simulation · demonstration · bench test · SIL · HIL · ground test · controlled flight test · operational validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontColor=#7c2d12;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p4_1"><mxGeometry x="1085" y="635" width="470" height="175" as="geometry"/></mxCell>
        <mxCell id="p4_note" value="&lt;b&gt;Acceptance principle:&lt;/b&gt; no simulation result alone authorizes real-world operation. Progression requires independent review, reproducible evidence and explicit closure of safety and regulatory assumptions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;fontColor=#334155;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="p4_1"><mxGeometry x="45" y="865" width="1510" height="60" as="geometry"/></mxCell>
        <mxCell id="p4_e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p4_1" source="p4_g0" target="p4_g1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p4_1" source="p4_g1" target="p4_g2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p4_1" source="p4_g2" target="p4_g3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p4_1" source="p4_g3" target="p4_g4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p4_1" source="p4_g4" target="p4_g5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p4_1" source="p4_g5" target="p4_g6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p4_1" source="p4_g6" target="p4_g7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p4_1" source="p4_g7" target="p4_g8"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="mass-evolution" name="05 - Evolution and MVP">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p5_0"/>
        <mxCell id="p5_1" parent="p5_0"/>
        <mxCell id="p5_title" value="&lt;b&gt;Evolution, MVP and Open Technical Decisions&lt;/b&gt;&lt;br&gt;Simulation-first path from concept baseline to an evidence-backed modular demonstrator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;fontSize=21;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="p5_1">
          <mxGeometry x="30" y="20" width="1540" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="p5_sub" value="The sequence keeps high-risk assumptions visible: first stabilize requirements and models, then add energy, mobility, payload and controlled aerial capability." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="p5_1">
          <mxGeometry x="30" y="94" width="1540" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="p5_e0" value="&lt;b&gt;MVP-0 — Concept baseline&lt;/b&gt;&lt;br&gt;Freeze mission, system boundary, assumptions, R-01…R-11, interface owners and TBD performance budgets.&lt;br&gt;&lt;br&gt;Exit: approved requirements and risk register" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p5_1"><mxGeometry x="35" y="190" width="285" height="170" as="geometry"/></mxCell>
        <mxCell id="p5_e1" value="&lt;b&gt;MVP-1 — Digital baseline&lt;/b&gt;&lt;br&gt;Create CAD abstraction, Modelica energy/vehicle models, OpenTwin data schema and scenario registry.&lt;br&gt;&lt;br&gt;Exit: reproducible model and traceability audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p5_1"><mxGeometry x="345" y="190" width="285" height="170" as="geometry"/></mxCell>
        <mxCell id="p5_e2" value="&lt;b&gt;MVP-2 — Ground electric demonstrator&lt;/b&gt;&lt;br&gt;Implement energy module, drive-by-wire, vehicle API, sensors, edge control, telemetry and interchangeable ground payload.&lt;br&gt;&lt;br&gt;Exit: SIL/HIL and integrated ground gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p5_1"><mxGeometry x="655" y="190" width="285" height="170" as="geometry"/></mxCell>
        <mxCell id="p5_e3" value="&lt;b&gt;MVP-3 — UAV and payload integration&lt;/b&gt;&lt;br&gt;Add detachable UAV interface, docking interlocks, flight-control bridge, mission payload and controlled test instrumentation.&lt;br&gt;&lt;br&gt;Exit: approved controlled aerial integration gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p5_1"><mxGeometry x="965" y="190" width="285" height="170" as="geometry"/></mxCell>
        <mxCell id="p5_e4" value="&lt;b&gt;MVP-4 — Verification and pilot&lt;/b&gt;&lt;br&gt;Expand the envelope incrementally, validate representative missions, close anomalies and prepare configuration/manufacturing evidence.&lt;br&gt;&lt;br&gt;Exit: independent review and pilot decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p5_1"><mxGeometry x="1275" y="190" width="290" height="170" as="geometry"/></mxCell>
        <mxCell id="p5_a" value="&lt;b&gt;Open technical decisions&lt;/b&gt;&lt;br&gt;• Ground-only, detachable-UAV or dual-mode baseline&lt;br&gt;• Propulsion topology and redundancy&lt;br&gt;• Battery chemistry, voltage and service strategy&lt;br&gt;• Autonomy level and human authority&lt;br&gt;• Environmental envelope and certification basis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p5_1"><mxGeometry x="35" y="460" width="480" height="205" as="geometry"/></mxCell>
        <mxCell id="p5_b" value="&lt;b&gt;Definition of done for the high-level baseline&lt;/b&gt;&lt;br&gt;• 100% of requirements have owner and allocation&lt;br&gt;• All interfaces have version and fault behavior&lt;br&gt;• SIL/HIL scenarios are reproducible&lt;br&gt;• Safe modes are demonstrated before autonomy claims&lt;br&gt;• Ground and flight evidence are separated&lt;br&gt;• Configuration and anomaly closure are auditable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p5_1"><mxGeometry x="560" y="460" width="480" height="205" as="geometry"/></mxCell>
        <mxCell id="p5_c" value="&lt;b&gt;Open-source reference stack&lt;/b&gt;&lt;br&gt;Modelica / OpenModelica · ROS 2 · PX4 or replaceable flight stack · Gazebo · Python/OpenCV · Linux · Docker · Kubernetes optional for shared simulation services · OpenTwin data contracts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="p5_1"><mxGeometry x="1085" y="460" width="480" height="205" as="geometry"/></mxCell>
        <mxCell id="p5_tbd" value="&lt;b&gt;Parameter register to be closed by engineering analysis&lt;/b&gt;&lt;br&gt;Mass and center of gravity · dimensions and clearances · payload and structural loads · energy capacity and power · ground/flight performance · endurance/range · thermal limits · communications latency · environmental conditions · maintenance intervals · safety targets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontColor=#7c2d12;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p5_1"><mxGeometry x="35" y="725" width="1530" height="125" as="geometry"/></mxCell>
        <mxCell id="p5_note" value="&lt;b&gt;Scope note:&lt;/b&gt; this evolution view is an engineering-planning aid. It does not define a production aircraft, road-legal vehicle or certified operational system." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;fontColor=#334155;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="p5_1"><mxGeometry x="35" y="890" width="1530" height="52" as="geometry"/></mxCell>
        <mxCell id="p5_e01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p5_1" source="p5_e0" target="p5_e1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p5_1" source="p5_e1" target="p5_e2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p5_1" source="p5_e2" target="p5_e3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_e34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;" edge="1" parent="p5_1" source="p5_e3" target="p5_e4"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
