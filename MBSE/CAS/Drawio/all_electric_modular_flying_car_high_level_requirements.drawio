        <mxCell id="p3_v3" value="&lt;b&gt;V-03&lt;/b&gt; Control-model review, SIL, HIL, ground maneuver test and operator-override demonstration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#7c2d12;fontSize=11;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="p3_1"><mxGeometry x="1070" y="341" width="500" height="58" as="geometry"/></mxCell>
        <mxCell id="p3_r4" value="&lt;b&gt;R-06&lt;/b&gt; Open and replaceable interfaces for ROS 2, vehicle API, telemetry, V2X and edge/cloud services." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#60a5fa;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="p3_1"><mxGeometry x="30" y="409" width="480" height="58" as="geometry"/></mxCell>
