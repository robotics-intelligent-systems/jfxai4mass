        </mxCell>
        <mxCell id="p3_r1" value="&lt;b&gt;R-03&lt;/b&gt; All-electric energy with safe modular storage, power distribution, BMS and thermal management." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#60a5fa;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="p3_1"><mxGeometry x="30" y="205" width="480" height="58" as="geometry"/></mxCell>
        <mxCell id="p3_a1" value="&lt;b&gt;S-02&lt;/b&gt; Energy module · BMS · power bus · thermal/isolation services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#4ade80;fontColor=#14532d;fontSize=11;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="p3_1"><mxGeometry x="550" y="205" width="480" height="58" as="geometry"/></mxCell>
        <mxCell id="p3_v1" value="&lt;b&gt;V-01&lt;/b&gt; Energy simulation, BMS bench test, isolation test, thermal test and abuse-case analysis." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#7c2d12;fontSize=11;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="p3_1"><mxGeometry x="1070" y="205" width="500" height="58" as="geometry"/></mxCell>
        <mxCell id="p3_r2" value="&lt;b&gt;R-04&lt;/b&gt; Interchangeable payload bay with mechanical, electrical and data compatibility." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#60a5fa;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="p3_1"><mxGeometry x="30" y="273" width="480" height="58" as="geometry"/></mxCell>
