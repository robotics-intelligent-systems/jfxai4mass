        <mxCell id="p3_v5" value="&lt;b&gt;V-05&lt;/b&gt; Model review, co-simulation, data replay, parameter correlation and reproducibility audit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#7c2d12;fontSize=11;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="p3_1"><mxGeometry x="1070" y="477" width="500" height="58" as="geometry"/></mxCell>
        <mxCell id="p3_r6" value="&lt;b&gt;R-08&lt;/b&gt; Fault detection, hazard isolation, controllability and safe ground/flight degraded modes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#60a5fa;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="p3_1"><mxGeometry x="30" y="545" width="480" height="58" as="geometry"/></mxCell>
