        <mxCell id="p3_v4" value="&lt;b&gt;V-04&lt;/b&gt; API/schema review, protocol conformance, latency test, interoperability and cybersecurity review." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#7c2d12;fontSize=11;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="p3_1"><mxGeometry x="1070" y="409" width="500" height="58" as="geometry"/></mxCell>
