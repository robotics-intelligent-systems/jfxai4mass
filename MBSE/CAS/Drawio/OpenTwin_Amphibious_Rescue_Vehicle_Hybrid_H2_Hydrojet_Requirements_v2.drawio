<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" modified="2026-09-09T03:25:54.415554+00:00" agent="ChatGPT" version="31.4.2" type="device">
<diagram id="29f0f3eb86d7" name="01 - Scope &amp; CONOPS"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="OpenTwin Amphibious Rescue Vehicle — High-Level Requirements Engineering — Hybrid H2-Electric / Hydrojet Revision" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="170" y="25" width="1260" height="70" as="geometry" /></mxCell><mxCell id="scope" value="&lt;b&gt;System Concept&lt;/b&gt;&lt;br&gt;Modular amphibious rescue vehicle for flood, riverbank, coastal-edge and difficult-terrain response. It combines ground mobility, low-speed water operation, rescue payloads, open vehicle interfaces, telemetry and an OpenTwin digital twin." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="140" width="430" height="250" as="geometry" /></mxCell><mxCell id="use" value="&lt;b&gt;Primary Use Cases&lt;/b&gt;&lt;br&gt;• Flood evacuation&lt;br&gt;• Search-and-rescue access&lt;br&gt;• River / shoreline rescue support&lt;br&gt;• Disaster-response logistics&lt;br&gt;• Medical/rescue payload transport&lt;br&gt;• Remote inspection / reconnaissance&lt;br&gt;• Training and simulation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="585" y="140" width="430" height="250" as="geometry" /></mxCell><mxCell id="stake" value="&lt;b&gt;Stakeholders&lt;/b&gt;&lt;br&gt;Rescue crew / operator&lt;br&gt;Evacuees / passengers&lt;br&gt;Incident commander&lt;br&gt;Mechanical / marine engineer&lt;br&gt;Electrical / controls engineer&lt;br&gt;Autonomy / AI engineer&lt;br&gt;Maintenance team&lt;br&gt;Regulatory and safety authorities" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1100" y="140" width="430" height="250" as="geometry" /></mxCell><mxCell id="bound" value="&lt;b&gt;System Boundary&lt;/b&gt;&lt;br&gt;IN: chassis/body, wheels/tracks as selected, steering/braking, buoyancy body, water propulsion, energy system, rescue cabin/payload, communications, sensors, HMI, safety systems, OpenTwin gateway and digital twin.&lt;br&gt;&lt;br&gt;OUT: detailed production certification, public-road approval, vessel certification, operational rescue doctrine." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="470" width="700" height="300" as="geometry" /></mxCell><mxCell id="modes" value="&lt;b&gt;Operational Modes&lt;/b&gt;&lt;br&gt;SAFE / OFF&lt;br&gt;LAND MOBILITY&lt;br&gt;WATER MOBILITY&lt;br&gt;LAND→WATER TRANSITION&lt;br&gt;WATER→LAND TRANSITION&lt;br&gt;RESCUE / EVACUATION&lt;br&gt;REMOTE ASSIST / AUTONOMY&lt;br&gt;DEGRADED / LIMP&lt;br&gt;MAINTENANCE / DIAGNOSTIC" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="470" width="700" height="300" as="geometry" /></mxCell><mxCell id="gate" value="&lt;b&gt;Engineering Baseline&lt;/b&gt;&lt;br&gt;Simulation-first development is required. Before real rescue use, the final design requires validated buoyancy, stability, structural integrity, occupant protection, egress, propulsion guarding, electrical safety, communication resilience, recovery procedures and jurisdiction-specific road/marine approval." style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="250" y="835" width="1100" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="c3ef33395573" name="02 - Functional Requirements"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Functional Requirements" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry" /></mxCell><mxCell id="FR-01" value="&lt;b&gt;FR-01 — Land Mobility&lt;/b&gt;&lt;br&gt;Vehicle shall provide controlled propulsion, steering and braking over the defined rescue terrain envelope." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="120" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-02" value="&lt;b&gt;FR-02 — Water Mobility&lt;/b&gt;&lt;br&gt;Vehicle shall provide controlled propulsion and steering within the validated water operating envelope." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="120" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-03" value="&lt;b&gt;FR-03 — Transition&lt;/b&gt;&lt;br&gt;Vehicle shall execute defined land↔water transition sequences with bounded speed and mode interlocks." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="120" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-04" value="&lt;b&gt;FR-04 — Buoyancy&lt;/b&gt;&lt;br&gt;Vehicle shall maintain positive buoyancy and required reserve buoyancy at approved rescue loading." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="325" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-05" value="&lt;b&gt;FR-05 — Stability&lt;/b&gt;&lt;br&gt;Vehicle shall maintain validated static and dynamic stability for occupants, crew and rescue payload." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="325" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-06" value="&lt;b&gt;FR-06 — Rescue Capacity&lt;/b&gt;&lt;br&gt;Vehicle shall provide configurable occupant/casualty capacity and secure restraint/handhold provisions." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="325" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-07" value="&lt;b&gt;FR-07 — Access/Egress&lt;/b&gt;&lt;br&gt;Vehicle shall provide rescue access, assisted boarding and emergency egress appropriate to the mission." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="530" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-08" value="&lt;b&gt;FR-08 — Mission Payload&lt;/b&gt;&lt;br&gt;Vehicle shall support modular payload interfaces for rescue, medical, communications, sensor or cargo modules." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="530" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-09" value="&lt;b&gt;FR-09 — Communications&lt;/b&gt;&lt;br&gt;Vehicle shall support local crew communications plus interoperable mission telemetry links." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="530" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-10" value="&lt;b&gt;FR-10 — OpenTwin Telemetry&lt;/b&gt;&lt;br&gt;Vehicle shall publish position, mode, speed, attitude, energy, propulsion, environment and health states." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="735" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-11" value="&lt;b&gt;FR-11 — Degraded Operation&lt;/b&gt;&lt;br&gt;Essential local mobility and safety functions shall remain available when remote services are unavailable." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="735" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-12" value="&lt;b&gt;FR-12 — Emergency Safe State&lt;/b&gt;&lt;br&gt;Operator shall be able to command a local safe/de-energized state independent of cloud connectivity." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="735" width="455" height="165" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="db7967b3f86e" name="03 - NFR &amp; Constraints"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Non-Functional Requirements &amp; Constraints" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry" /></mxCell><mxCell id="n0" value="&lt;b&gt;NFR-01 Life Safety&lt;/b&gt;&lt;br&gt;Occupant protection, handholds, restraints, egress and rescue workflow shall address foreseeable emergency conditions." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="120" width="455" height="165" as="geometry" /></mxCell><mxCell id="n1" value="&lt;b&gt;NFR-02 Structural&lt;/b&gt;&lt;br&gt;Chassis, body, suspension and payload mounts shall be verified for road/off-road, launch, water and rescue load cases." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="120" width="455" height="165" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;NFR-03 Marine Stability&lt;/b&gt;&lt;br&gt;Displacement, freeboard, trim and stability shall be verified for each approved loading condition." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="120" width="455" height="165" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;NFR-04 Environmental&lt;/b&gt;&lt;br&gt;Critical hardware shall withstand expected water, mud, dust, vibration, temperature and corrosion exposure." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="325" width="455" height="165" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;NFR-05 Functional Safety&lt;/b&gt;&lt;br&gt;Safety-critical actuation shall fail to a defined safe/degraded state and use local deterministic interlocks." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="325" width="455" height="165" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;NFR-06 Maintainability&lt;/b&gt;&lt;br&gt;Seals, drains, propulsion, pumps, energy storage, electronics and rescue modules shall be inspectable/serviceable." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="325" width="455" height="165" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;NFR-07 Modularity&lt;/b&gt;&lt;br&gt;Drive, energy, compute, sensors, communications and payload modules should use documented open interfaces." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="530" width="455" height="165" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;NFR-08 Cybersecurity&lt;/b&gt;&lt;br&gt;Remote commands shall require authentication, authorization, protected credentials and command auditing." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="530" width="455" height="165" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;NFR-09 Resilience&lt;/b&gt;&lt;br&gt;Loss of GNSS, cloud, WAN or AI service shall not disable essential local rescue operation." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="530" width="455" height="165" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;NFR-10 Data Provenance&lt;/b&gt;&lt;br&gt;Twin data shall include timestamp, source, quality, configuration and software/model version metadata." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="735" width="455" height="165" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;NFR-11 Human Factors&lt;/b&gt;&lt;br&gt;Controls, warnings and mode annunciation shall be unambiguous under stressful, wet and low-visibility conditions." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="735" width="455" height="165" as="geometry" /></mxCell><mxCell id="n11" value="&lt;b&gt;NFR-12 Compliance&lt;/b&gt;&lt;br&gt;Final system requirements shall map to applicable vehicle, watercraft, emergency-response, electrical and occupational-safety rules." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="735" width="455" height="165" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="b0028780e593" name="04 - Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="OpenTwin Amphibious Rescue Vehicle — Reference Architecture" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="170" y="25" width="1260" height="70" as="geometry" /></mxCell><mxCell id="mob" value="&lt;b&gt;MOBILITY PLATFORM&lt;/b&gt;&lt;br&gt;Chassis/body&lt;br&gt;Suspension&lt;br&gt;Wheels/tracks&lt;br&gt;Steering/braking&lt;br&gt;Waterproofing&lt;br&gt;Buoyant structure" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="55" y="155" width="280" height="280" as="geometry" /></mxCell><mxCell id="prop" value="&lt;b&gt;PROPULSION / ENERGY&lt;/b&gt;&lt;br&gt;Ground drive&lt;br&gt;Water propulsion&lt;br&gt;Energy storage / hybrid option&lt;br&gt;Power distribution&lt;br&gt;Cooling&lt;br&gt;Emergency isolation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="385" y="155" width="280" height="280" as="geometry" /></mxCell><mxCell id="rescue" value="&lt;b&gt;RESCUE MODULE&lt;/b&gt;&lt;br&gt;Occupant/casualty zone&lt;br&gt;Handholds/restraints&lt;br&gt;Medical/rescue equipment&lt;br&gt;Lighting&lt;br&gt;Recovery interfaces&lt;br&gt;Optional winch/pump modules" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="715" y="155" width="280" height="280" as="geometry" /></mxCell><mxCell id="sens" value="&lt;b&gt;SENSORS / COMMS&lt;/b&gt;&lt;br&gt;GNSS / IMU&lt;br&gt;Cameras&lt;br&gt;Water/depth/ingress sensing&lt;br&gt;Vehicle telemetry&lt;br&gt;Radio / data links&lt;br&gt;V2X optional" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1045" y="155" width="280" height="280" as="geometry" /></mxCell><mxCell id="edge" value="&lt;b&gt;OPENTWIN EDGE&lt;/b&gt;&lt;br&gt;Vehicle abstraction&lt;br&gt;Mode state machine&lt;br&gt;Telemetry/event buffer&lt;br&gt;Health monitoring&lt;br&gt;Open APIs&lt;br&gt;Offline-first control" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1045" y="570" width="280" height="260" as="geometry" /></mxCell><mxCell id="twin" value="&lt;b&gt;DIGITAL TWIN&lt;/b&gt;&lt;br&gt;Vehicle Twin&lt;br&gt;Mobility Twin&lt;br&gt;Energy Twin&lt;br&gt;Rescue Payload Twin&lt;br&gt;Environment Twin&lt;br&gt;Maintenance Twin" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="715" y="570" width="280" height="260" as="geometry" /></mxCell><mxCell id="sim" value="&lt;b&gt;SIMULATION / MODELICA&lt;/b&gt;&lt;br&gt;Vehicle dynamics&lt;br&gt;Electrical/energy&lt;br&gt;Thermal&lt;br&gt;Fluid/buoyancy abstraction&lt;br&gt;Control&lt;br&gt;Scenario simulation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="385" y="570" width="280" height="260" as="geometry" /></mxCell><mxCell id="ai" value="&lt;b&gt;AI / AUTONOMY&lt;/b&gt;&lt;br&gt;Perception&lt;br&gt;Terrain/water classification&lt;br&gt;Route/mission planning&lt;br&gt;Obstacle detection&lt;br&gt;Predictive maintenance&lt;br&gt;Decision support" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="55" y="570" width="280" height="260" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="mob" target="prop"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="prop" target="rescue"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="rescue" target="sens"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="sens" target="edge"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="edge" target="twin"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="sim" target="twin"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="ai" target="twin"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="1176b0c1c167" name="05 - Modes &amp; Safety"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Mission Modes, Safety Interlocks &amp; Degraded Operation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="170" y="25" width="1260" height="70" as="geometry" /></mxCell><mxCell id="safe" value="&lt;b&gt;SAFE / OFF&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="90" y="390" width="250" height="100" as="geometry" /></mxCell><mxCell id="land" value="&lt;b&gt;LAND&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="390" y="170" width="250" height="100" as="geometry" /></mxCell><mxCell id="lw" value="&lt;b&gt;LAND→WATER&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="735" y="170" width="250" height="100" as="geometry" /></mxCell><mxCell id="water" value="&lt;b&gt;WATER&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1110" y="390" width="250" height="100" as="geometry" /></mxCell><mxCell id="wl" value="&lt;b&gt;WATER→LAND&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="735" y="615" width="250" height="100" as="geometry" /></mxCell><mxCell id="res" value="&lt;b&gt;RESCUE / EVAC&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="390" y="615" width="250" height="100" as="geometry" /></mxCell><mxCell id="rules" value="&lt;b&gt;High-level guards&lt;/b&gt;&lt;br&gt;• Mode transitions require validated speed, attitude, propulsion and ingress conditions.&lt;br&gt;• Incompatible ground/water propulsion commands shall be inhibited.&lt;br&gt;• Critical leak, thermal, energy, steering or control faults shall force a defined degraded or safe response.&lt;br&gt;• Rescue/evacuation mode shall prioritize stability, low-speed maneuvering, lighting, communications and occupant safety over performance.&lt;br&gt;• Exact thresholds are TBD by engineering analysis and controlled testing." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="360" y="805" width="920" height="170" as="geometry" /></mxCell><mxCell id="a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="safe" target="land"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="land" target="lw"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="lw" target="water"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="water" target="wl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="wl" target="land"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="land" target="res"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="g" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="water" target="res"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="h" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="res" target="safe"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="233c83ee770a" name="06 - Interfaces &amp; Twin Data"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Rescue Systems, Interfaces &amp; OpenTwin Data Model" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="170" y="25" width="1260" height="70" as="geometry" /></mxCell><mxCell id="i0" value="&lt;b&gt;IF-01 Mobility&lt;/b&gt;&lt;br&gt;Frame/chassis ↔ suspension ↔ ground drive ↔ water propulsion; sealed structural and service interfaces." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="130" width="690" height="160" as="geometry" /></mxCell><mxCell id="i1" value="&lt;b&gt;IF-02 Rescue Payload&lt;/b&gt;&lt;br&gt;Standardized mechanical/electrical/data interface for rescue cabin, medical, cargo, winch, pump or sensor modules." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="130" width="690" height="160" as="geometry" /></mxCell><mxCell id="i2" value="&lt;b&gt;IF-03 Energy&lt;/b&gt;&lt;br&gt;Protected traction/auxiliary power, emergency isolation, low-voltage safety power and optional external charging/refueling." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="335" width="690" height="160" as="geometry" /></mxCell><mxCell id="i3" value="&lt;b&gt;IF-04 Communications&lt;/b&gt;&lt;br&gt;Vehicle bus, ROS 2/service APIs, CAN, MQTT/V2X or equivalent adapters; local event buffering." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="335" width="690" height="160" as="geometry" /></mxCell><mxCell id="i4" value="&lt;b&gt;IF-05 Human&lt;/b&gt;&lt;br&gt;Steering, throttle/brake, mode control, emergency stop, mission HMI, passenger handholds and assisted boarding." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="540" width="690" height="160" as="geometry" /></mxCell><mxCell id="i5" value="&lt;b&gt;IF-06 Environment&lt;/b&gt;&lt;br&gt;Terrain contact, water forces, immersion/splash boundaries, bilge/ingress sensing, temperature and corrosion exposure." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="540" width="690" height="160" as="geometry" /></mxCell><mxCell id="schema" value="&lt;b&gt;Minimum OpenTwin rescue state&lt;/b&gt;&lt;br&gt;asset_id · configuration_id · mission_id · operating_mode · position · land/water speed · attitude · propulsion_state · energy_state · ingress_status · occupant/payload load class · communications_state · rescue-module status · environmental alerts · faults · maintenance_due · software/model versions · timestamp · provenance" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="280" y="770" width="1040" height="180" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="5d212a99cb7b" name="07 - Simulation &amp; AI"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Simulation, AI &amp; MBSE Verification Strategy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry" /></mxCell><mxCell id="mbse" value="&lt;b&gt;MBSE / Capella&lt;/b&gt;&lt;br&gt;Needs&lt;br&gt;CONOPS&lt;br&gt;Rescue scenarios&lt;br&gt;Logical/physical architecture&lt;br&gt;Interface requirements" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="160" width="270" height="240" as="geometry" /></mxCell><mxCell id="mod" value="&lt;b&gt;Modelica / Multiphysics&lt;/b&gt;&lt;br&gt;Vehicle dynamics&lt;br&gt;Energy&lt;br&gt;Thermal&lt;br&gt;Buoyancy / fluids abstraction&lt;br&gt;Control&lt;br&gt;Actuators" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="390" y="160" width="270" height="240" as="geometry" /></mxCell><mxCell id="sim" value="&lt;b&gt;Vehicle / Robotics Simulation&lt;/b&gt;&lt;br&gt;ROS 2&lt;br&gt;Gazebo / open simulator&lt;br&gt;Terrain/water scenarios&lt;br&gt;Sensor simulation&lt;br&gt;Mission events" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="710" y="160" width="270" height="240" as="geometry" /></mxCell><mxCell id="ai" value="&lt;b&gt;AI / Autonomy&lt;/b&gt;&lt;br&gt;Perception&lt;br&gt;Terrain/water classification&lt;br&gt;Route planning&lt;br&gt;Obstacle avoidance&lt;br&gt;Human-supervised mission aid" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1030" y="160" width="270" height="240" as="geometry" /></mxCell><mxCell id="vv" value="&lt;b&gt;Verification Chain&lt;/b&gt;&lt;br&gt;Requirements → model tests → scenario tests → SIL/HIL where applicable → prototype subsystem tests → controlled land test → controlled water test → transition test → supervised rescue drill" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="250" y="560" width="1100" height="150" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Repository alignment:&lt;/b&gt; jfxai4mass explicitly targets modular autonomous mobility, rescue modules, digital twins, Modelica, ROS 2, simulation, open vehicle APIs and AI/autonomy. The amphibious rescue vehicle is treated as a new modular rescue concept within that architecture, not as an already certified or complete system." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="250" y="780" width="1100" height="140" as="geometry" /></mxCell><mxCell id="m1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="mbse" target="mod"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="mod" target="sim"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="sim" target="ai"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="ai" target="vv"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="d0fd434c2a77" name="08 - V&amp;V Traceability"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Verification, Validation &amp; Traceability" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry" /></mxCell><mxCell id="v0" value="&lt;b&gt;V-01 Inspection&lt;/b&gt;&lt;br&gt;Guards, access/egress, restraints, rescue-module retention, sealing, labels and serviceability." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="120" width="690" height="130" as="geometry" /></mxCell><mxCell id="v1" value="&lt;b&gt;V-02 Analysis&lt;/b&gt;&lt;br&gt;Mass/CG, structural loads, axle/suspension loads, buoyancy, freeboard, stability, energy and thermal budgets." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="120" width="690" height="130" as="geometry" /></mxCell><mxCell id="v2" value="&lt;b&gt;V-03 Simulation&lt;/b&gt;&lt;br&gt;Ground/water dynamics, transitions, degraded modes, rescue scenarios, control logic and sensor failure cases." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="290" width="690" height="130" as="geometry" /></mxCell><mxCell id="v3" value="&lt;b&gt;V-04 Bench / HIL&lt;/b&gt;&lt;br&gt;Power, controllers, communications, sensors, leak detection, propulsion interlocks, emergency safe state." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="290" width="690" height="130" as="geometry" /></mxCell><mxCell id="v4" value="&lt;b&gt;V-05 Controlled Land Test&lt;/b&gt;&lt;br&gt;Low-speed handling, braking, off-road maneuvering, rescue payload stability and thermal performance." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="460" width="690" height="130" as="geometry" /></mxCell><mxCell id="v5" value="&lt;b&gt;V-06 Controlled Water Test&lt;/b&gt;&lt;br&gt;Progressive flotation, trim, stability, water propulsion, steering, ingress and recovery testing." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="460" width="690" height="130" as="geometry" /></mxCell><mxCell id="v6" value="&lt;b&gt;V-07 Transition Test&lt;/b&gt;&lt;br&gt;Controlled land-water transitions after independent land/water criteria are satisfied." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="630" width="690" height="130" as="geometry" /></mxCell><mxCell id="v7" value="&lt;b&gt;V-08 Rescue Drill&lt;/b&gt;&lt;br&gt;Supervised boarding, casualty/passenger handling, communications, lighting, recovery and egress workflow." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="630" width="690" height="130" as="geometry" /></mxCell><mxCell id="v8" value="&lt;b&gt;V-09 OpenTwin V&amp;V&lt;/b&gt;&lt;br&gt;State consistency, latency, event chronology, configuration traceability, offline recovery and telemetry quality." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="800" width="690" height="130" as="geometry" /></mxCell><mxCell id="v9" value="&lt;b&gt;V-10 Compliance Review&lt;/b&gt;&lt;br&gt;Map final configuration to applicable vehicle, watercraft, emergency-response, electrical and occupational-safety requirements." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="800" width="690" height="130" as="geometry" /></mxCell><mxCell id="trace" value="&lt;b&gt;Traceability:&lt;/b&gt; Stakeholder Need → System Requirement → Rescue/Vehicle Subsystem Requirement → Design Element → Verification Method → Evidence → Configuration Baseline" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="240" y="925" width="1120" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="cfff76c169fc" name="09 - MVP &amp; Roadmap"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="MVP Technology Demonstrator &amp; Development Roadmap" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="170" y="25" width="1260" height="70" as="geometry" /></mxCell><mxCell id="mvp" value="&lt;b&gt;MVP / Technology Demonstrator&lt;/b&gt;&lt;br&gt;• Simplified amphibious chassis/body&lt;br&gt;• Low-speed ground mobility&lt;br&gt;• Low-speed enclosed water propulsion&lt;br&gt;• Manual operator controls&lt;br&gt;• Safe land/water mode logic&lt;br&gt;• Basic rescue payload bay / handholds&lt;br&gt;• Energy and thermal sensing&lt;br&gt;• IMU / GNSS / speed sensing&lt;br&gt;• Ingress/leak detection&lt;br&gt;• Local communications&lt;br&gt;• OpenTwin edge gateway&lt;br&gt;• Telemetry and event history" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="140" width="430" height="580" as="geometry" /></mxCell><mxCell id="p1" value="&lt;b&gt;Phase 1 — Requirements / MBSE&lt;/b&gt;&lt;br&gt;Rescue CONOPS&lt;br&gt;Hazards&lt;br&gt;Occupancy/payload classes&lt;br&gt;Operating envelope&lt;br&gt;Requirements baseline" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="560" y="140" width="380" height="220" as="geometry" /></mxCell><mxCell id="p2" value="&lt;b&gt;Phase 2 — Digital Engineering&lt;/b&gt;&lt;br&gt;CAD packaging&lt;br&gt;Mass/CG&lt;br&gt;Vehicle dynamics&lt;br&gt;Buoyancy/stability&lt;br&gt;Energy/thermal models" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1010" y="140" width="380" height="220" as="geometry" /></mxCell><mxCell id="p3" value="&lt;b&gt;Phase 3 — Simulation / OpenTwin&lt;/b&gt;&lt;br&gt;Modelica&lt;br&gt;ROS 2 / simulator&lt;br&gt;Telemetry&lt;br&gt;Digital twin&lt;br&gt;Scenario library&lt;br&gt;AI experiments" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="560" y="440" width="380" height="220" as="geometry" /></mxCell><mxCell id="p4" value="&lt;b&gt;Phase 4 — Controlled Prototype&lt;/b&gt;&lt;br&gt;Subsystem rigs&lt;br&gt;Land test&lt;br&gt;Water test&lt;br&gt;Transition test&lt;br&gt;Rescue drill&lt;br&gt;Traceability closure" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1010" y="440" width="380" height="220" as="geometry" /></mxCell><mxCell id="gate" value="&lt;b&gt;Release Gate&lt;/b&gt;&lt;br&gt;No operational rescue deployment or public-road/navigable-water use until applicable structural, stability, occupant-safety, propulsion, electrical, cybersecurity, communications, rescue-equipment and jurisdiction-specific requirements have been independently reviewed and satisfied." style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="420" y="805" width="1000" height="130" as="geometry" /></mxCell><mxCell id="r1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="p4" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram id="96e226c4fb7b" name="10 - Hybrid H2-Electric &amp; Hydrojet"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Hybrid Hydrogen-Electric Wheel Drive + Mini Hydrojet — High-Level Requirements" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="160" y="25" width="1280" height="70" as="geometry" /></mxCell><mxCell id="arch" value="&lt;b&gt;Hybrid Propulsion Architecture&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hydrogen storage and supply → fuel-cell or equivalent H2 energy-conversion module → protected DC bus → independent electric wheel motors for land propulsion + compact electrically driven hydrojet for water propulsion.&lt;br&gt;&lt;br&gt;The architecture shall support modular replacement of propulsion, energy-conversion and control modules." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="470" height="255" as="geometry" /></mxCell><mxCell id="h2" value="&lt;b&gt;Hydrogen Subsystem — H2 Requirements&lt;/b&gt;&lt;br&gt;H2-001 Hydrogen storage, fittings and delivery components shall be purpose-designed and rated for the intended service.&lt;br&gt;H2-002 The vehicle shall include leak detection, isolation, pressure regulation and ventilation strategy.&lt;br&gt;H2-003 Hydrogen components shall be segregated from ignition sources and hot surfaces where practicable.&lt;br&gt;H2-004 Emergency shutdown shall isolate hydrogen flow locally, independent of cloud or remote services.&lt;br&gt;H2-005 Refueling/service interfaces shall be identified, protected and accessible only to authorized procedures." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="585" y="130" width="460" height="315" as="geometry" /></mxCell><mxCell id="elec" value="&lt;b&gt;Electric Wheel Drive — EWD Requirements&lt;/b&gt;&lt;br&gt;EWD-001 Each driven wheel may use an independent electric motor with torque command and status feedback.&lt;br&gt;EWD-002 Traction control shall constrain torque during low-grip, rescue, transition and degraded conditions.&lt;br&gt;EWD-003 The DC power bus shall include isolation, overcurrent protection, fault monitoring and safe startup/shutdown strategy.&lt;br&gt;EWD-004 Regenerative braking may be supported if compatible with stability and rescue-safety constraints.&lt;br&gt;EWD-005 Critical motor, inverter or bus faults shall produce a bounded degraded or safe state." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1090" y="130" width="440" height="315" as="geometry" /></mxCell><mxCell id="jet" value="&lt;b&gt;Mini Hydrojet — HJ Requirements&lt;/b&gt;&lt;br&gt;HJ-001 Water propulsion shall use a compact guarded hydrojet or equivalently enclosed water-thrust module.&lt;br&gt;HJ-002 Intake and outlet geometry shall reduce accidental contact with moving elements and entanglement risk.&lt;br&gt;HJ-003 Hydrojet enable shall be interlocked with WATER MOBILITY or approved transition states.&lt;br&gt;HJ-004 The system shall monitor hydrojet speed, current, temperature or equivalent health indicators.&lt;br&gt;HJ-005 Intake blockage, cavitation or abnormal load shall produce an alert and bounded degraded response." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="500" width="470" height="315" as="geometry" /></mxCell><mxCell id="ctrl" value="&lt;b&gt;Supervisory Energy and Mode Control&lt;/b&gt;&lt;br&gt;CTRL-001 A supervisory controller shall coordinate hydrogen energy conversion, DC bus, wheel motors and hydrojet.&lt;br&gt;CTRL-002 LAND MOBILITY shall prioritize wheel traction and inhibit unintended hydrojet thrust.&lt;br&gt;CTRL-003 WATER MOBILITY shall prioritize hydrojet thrust and constrain wheel-motor behavior to the validated strategy.&lt;br&gt;CTRL-004 Transition modes shall enforce speed, attitude, ingress and energy preconditions.&lt;br&gt;CTRL-005 Safety interlocks shall remain local, deterministic and available during degraded communications." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="585" y="500" width="460" height="315" as="geometry" /></mxCell><mxCell id="twin" value="&lt;b&gt;OpenTwin Hybrid Propulsion Twin&lt;/b&gt;&lt;br&gt;Minimum twin state should include:&lt;br&gt;• hydrogen pressure and isolation status&lt;br&gt;• leak detector status&lt;br&gt;• fuel-cell / H2 conversion-module state&lt;br&gt;• DC bus voltage/current&lt;br&gt;• wheel-motor torque, speed and temperature&lt;br&gt;• hydrojet speed/current/temperature&lt;br&gt;• operating mode and transition state&lt;br&gt;• energy reserve / thermal status&lt;br&gt;• faults, maintenance due and software version&lt;br&gt;&lt;br&gt;Telemetry shall preserve timestamp, source, quality and provenance metadata." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1090" y="500" width="440" height="315" as="geometry" /></mxCell><mxCell id="vv" value="&lt;b&gt;Verification and Safety Gates&lt;/b&gt;&lt;br&gt;Analysis: hydrogen inventory, ventilation, thermal loads, electrical fault energy, mass/CG, propulsion sizing and stability impacts.&lt;br&gt;Bench tests: leak detection, isolation, pre-charge, inverter/motor controls, hydrojet protection and interlocks.&lt;br&gt;Controlled prototype tests: low-energy land traction, static water-thrust test, progressive water trial, transition test and rescue payload stability.&lt;br&gt;Applicable hydrogen, electrical, vehicle, marine and emergency-service requirements must be identified before field release." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="885" width="1000" height="170" as="geometry" /></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="arch" target="h2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="h2" target="elec"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="elec" target="ctrl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ctrl" target="jet"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ctrl" target="twin"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>