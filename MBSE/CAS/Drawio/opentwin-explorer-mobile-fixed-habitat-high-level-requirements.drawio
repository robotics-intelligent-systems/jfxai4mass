        <mxCell id="title" value="OpenTwin | Explorer mobile and fixed habitat | 03 | Acceptance parameters" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=24;fontColor=#ffffff;fillColor=#16324f;strokeColor=#bac9d8;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="TBD-1" value="TBD-EXP-01 | Occupancy, accessibility and stay duration&lt;br&gt;&lt;br&gt;Owner: systems engineering with allocated domain lead. Closure: analysis and&lt;br&gt;stakeholder review establish measurable limits and verification scenarios&lt;br&gt;before&lt;br&gt;G1. Status: open; no value inferred from artwork." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#152b43;fillColor=#ffffff;strokeColor=#bac9d8;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="740" height="360" as="geometry" />
        </mxCell>
        <mxCell id="TBD-2" value="TBD-EXP-02 | Temperature, humidity, air-quality and ventilation limits&lt;br&gt;&lt;br&gt;Owner: systems engineering with allocated domain lead. Closure: analysis and&lt;br&gt;stakeholder review establish measurable limits and verification scenarios&lt;br&gt;before&lt;br&gt;G1. Status: open; no value inferred from artwork." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#152b43;fillColor=#ffffff;strokeColor=#bac9d8;" vertex="1" parent="1">
          <mxGeometry x="820" y="140" width="740" height="360" as="geometry" />
